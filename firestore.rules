rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string;
    }

    function isAdmin() {
      return hasVerifiedEmail()
        && request.auth.token.get('email', '').lower() == 'tuananhdao.dev.js@gmail.com';
    }

    function accessRequestPath(uid) {
      return /databases/$(database)/documents/accessRequests/$(uid);
    }

    function isApproved() {
      return isAdmin()
        || (signedIn()
          && exists(accessRequestPath(request.auth.uid))
          && get(accessRequestPath(request.auth.uid)).data.status == 'approved');
    }

    function emailHash() {
      return hashing.sha256(request.auth.token.get('email', '').lower().toUtf8()).toHexString().lower();
    }

    function topicPath(topicId) {
      return /databases/$(database)/documents/topics/$(topicId);
    }

    function memberPath(topicId, uid) {
      return /databases/$(database)/documents/topics/$(topicId)/members/$(uid);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(username) {
      return /databases/$(database)/documents/usernames/$(username);
    }

    function isTopicOwner(topicId) {
      return signedIn() && exists(topicPath(topicId))
        && get(topicPath(topicId)).data.ownerId == request.auth.uid;
    }

    function hasTopicMembership(topicId) {
      return signedIn() && exists(memberPath(topicId, request.auth.uid));
    }

    function topicMemberRole(topicId, uid) {
      return exists(memberPath(topicId, uid))
        ? get(memberPath(topicId, uid)).data.role
        : '';
    }

    function canViewTopic(topicId) {
      return isAdmin()
        || (isApproved()
          && (isTopicOwner(topicId)
            || topicMemberRole(topicId, request.auth.uid) in ['viewer', 'editor']));
    }

    function canEditTopic(topicId) {
      return isAdmin()
        || (isApproved()
          && (isTopicOwner(topicId)
            || (hasTopicMembership(topicId)
              && get(memberPath(topicId, request.auth.uid)).data.role == 'editor')));
    }

    function shareAudienceAllows(share) {
      return share.get('audience', 'anyone') == 'anyone'
        || (share.get('audience', 'anyone') == 'approvedUsers'
          && hasVerifiedEmail()
          && isApproved());
    }

    function activeShare(topicId, shareId) {
      return shareId is string
        && exists(/databases/$(database)/documents/publicShares/$(shareId))
        && get(/databases/$(database)/documents/publicShares/$(shareId)).data.active == true
        && get(/databases/$(database)/documents/publicShares/$(shareId)).data.topicId == topicId
        && shareAudienceAllows(get(/databases/$(database)/documents/publicShares/$(shareId)).data);
    }

    function activeTopicShare(topicId) {
      return exists(topicPath(topicId))
        && activeShare(topicId, get(topicPath(topicId)).data.get('publicShareId', null));
    }

    function isInvitee(invitation) {
      return hasVerifiedEmail()
          && invitation.get('inviteeEmailHash', '') == emailHash()
          || (signedIn()
            && invitation.get('inviteeUsername', '') is string
            && exists(userPath(request.auth.uid))
            && get(userPath(request.auth.uid)).data.username == invitation.inviteeUsername);
    }

    match /accessRequests/{userId} {
      allow get: if signedIn() && (isAdmin() || userId == request.auth.uid);
      allow list: if isAdmin();

      allow create: if hasVerifiedEmail()
        && userId == request.auth.uid
        && !exists(accessRequestPath(userId))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'avatarUrl', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'avatarUrl', 'status', 'createdAt'
        ]);

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'approvedBy', 'approvedAt'
        ]);

      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if isApproved();
      allow list: if false;

      allow create: if isApproved()
        && request.resource.data.username == username
        && request.resource.data.keys().hasAll(['username', 'displayName', 'avatarUrl'])
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'avatarUrl', 'createdAt', 'updatedAt'])
        && !exists(usernamePath(username))
        && getAfter(userPath(request.auth.uid)).data.username == username;

      allow update: if isApproved()
        && get(userPath(request.auth.uid)).data.username == username
        && getAfter(userPath(request.auth.uid)).data.username == username
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'avatarUrl', 'createdAt', 'updatedAt']);

      allow delete: if isApproved()
        && get(userPath(request.auth.uid)).data.username == username
        && getAfter(userPath(request.auth.uid)).data.username != username;
    }

    match /users/{userId} {
      allow get: if isApproved() && signedIn() && userId == request.auth.uid;
      allow list: if false;
      allow create: if isApproved()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll(['uid', 'email', 'username', 'displayName', 'avatarUrl'])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'displayName', 'avatarUrl', 'createdAt', 'updatedAt'
        ])
        && getAfter(usernamePath(request.resource.data.username)).data.username == request.resource.data.username;
      allow update: if isApproved()
        && userId == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'displayName', 'avatarUrl', 'createdAt', 'updatedAt'
        ])
        && getAfter(usernamePath(request.resource.data.username)).data.username == request.resource.data.username;
      allow delete: if isApproved() && userId == request.auth.uid;
    }

    // This recursive rule lets each approved user query their own memberships.
    match /{path=**}/members/{memberUid} {
      allow get, list: if isApproved()
        && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /topics/{topicId} {
      allow get: if canViewTopic(topicId)
        || activeShare(topicId, resource.data.get('publicShareId', null));

      allow list: if isAdmin()
        || (isApproved()
          && (resource.data.ownerId == request.auth.uid || hasTopicMembership(topicId)));

      allow create: if isApproved()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility == 'private'
        && request.resource.data.publicShareId == null
        && request.resource.data.keys().hasAll([
          'ownerId', 'title', 'description', 'coverImagePath', 'visibility',
          'publicShareId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerId', 'title', 'description', 'coverImagePath', 'visibility',
          'publicShareId', 'createdAt', 'updatedAt'
        ]);

      allow update: if isAdmin()
        ? request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'ownerId', 'title', 'description', 'coverImagePath', 'visibility',
            'publicShareId', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.visibility in ['private', 'unlisted']
        : isApproved()
          && canEditTopic(topicId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'ownerId', 'title', 'description', 'coverImagePath', 'visibility',
            'publicShareId', 'createdAt', 'updatedAt'
          ])
          && (
            (isTopicOwner(topicId)
              && request.resource.data.visibility in ['private', 'unlisted'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'description', 'coverImagePath', 'updatedAt'
            ])
          );

      allow delete: if isAdmin() || (isApproved() && isTopicOwner(topicId));

      match /tips/{tipId} {
        allow get, list: if canViewTopic(topicId) || activeTopicShare(topicId);

        allow create: if canEditTopic(topicId)
          && request.resource.data.keys().hasAll([
            'title', 'summary', 'blocks', 'position', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'title', 'summary', 'blocks', 'position', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if canEditTopic(topicId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'title', 'summary', 'blocks', 'position', 'createdBy', 'createdAt', 'updatedAt'
          ]);

        allow delete: if canEditTopic(topicId);
      }

      match /members/{memberUid} {
        allow get, list: if isAdmin()
          || (isApproved()
            && (resource.data.uid == request.auth.uid || canViewTopic(topicId)));

        allow create: if canEditTopic(topicId)
          && request.resource.data.uid == memberUid
          && request.resource.data.role in ['viewer', 'editor']
          && request.resource.data.keys().hasOnly(['uid', 'role', 'invitationId', 'addedAt']);

        allow create: if isApproved()
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['viewer', 'editor']
          && request.resource.data.keys().hasOnly(['uid', 'role', 'invitationId', 'addedAt'])
          && request.resource.data.invitationId is string
          && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.acceptedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.topicId == topicId
          && isInvitee(getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data)
          && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role;

        allow update: if (isAdmin() || isTopicOwner(topicId))
          && request.resource.data.uid == memberUid
          && request.resource.data.role in ['viewer', 'editor']
          && request.resource.data.keys().hasOnly(['uid', 'role', 'invitationId', 'addedAt']);

        allow delete: if isAdmin()
          || (isApproved() && (isTopicOwner(topicId) || memberUid == request.auth.uid));
      }
    }

    match /invitations/{invitationId} {
      allow get, list: if isAdmin()
        || (isApproved()
          && (resource.data.inviterUid == request.auth.uid || isInvitee(resource.data)));

      allow create: if isApproved()
        && request.resource.data.inviterUid == request.auth.uid
        && canEditTopic(request.resource.data.topicId)
        && request.resource.data.role in ['viewer', 'editor']
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'topicId', 'inviterUid', 'role', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'topicId', 'inviterUid', 'invitedEmail', 'inviteeEmailHash', 'inviteeUsername',
          'role', 'status', 'createdAt', 'acceptedBy', 'acceptedAt'
        ])
        && (
          (request.resource.data.get('invitedEmail', '') is string
            && request.resource.data.get('invitedEmail', '') != ''
            && request.resource.data.get('inviteeEmailHash', '') == hashing.sha256(request.resource.data.invitedEmail.lower().toUtf8()).toHexString().lower()
            && request.resource.data.get('inviteeUsername', '') == '')
          || (request.resource.data.get('inviteeUsername', '') is string
            && request.resource.data.inviteeUsername.matches('^[a-z0-9][a-z0-9._-]{2,23}$')
            && request.resource.data.get('invitedEmail', '') == ''
            && request.resource.data.get('inviteeEmailHash', '') == ''
            && exists(userPath(request.auth.uid))
            && request.resource.data.inviteeUsername != get(userPath(request.auth.uid)).data.username
            && exists(usernamePath(request.resource.data.inviteeUsername)))
        );

      allow update: if isAdmin()
        ? resource.data.status == 'pending'
          && request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        : isApproved()
          && resource.data.status == 'pending'
          && (
            (resource.data.inviterUid == request.auth.uid
              && request.resource.data.status == 'revoked'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
            || (isInvitee(resource.data)
              && request.resource.data.status == 'accepted'
              && request.resource.data.acceptedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']))
          );

      allow delete: if isAdmin()
        || (isApproved()
          && resource.data.inviterUid == request.auth.uid
          && resource.data.status == 'pending');
    }

    match /publicShares/{shareId} {
      allow get: if isAdmin()
        || (resource.data.active == true && shareAudienceAllows(resource.data))
        || (isApproved() && resource.data.ownerUid == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isApproved()
        && request.resource.data.active == true
        && request.resource.data.topicId is string
        && request.resource.data.ownerUid == get(topicPath(request.resource.data.topicId)).data.ownerId
        && request.resource.data.audience in ['anyone', 'approvedUsers']
        && request.resource.data.keys().hasAll(['topicId', 'ownerUid', 'active', 'audience', 'createdAt'])
        && request.resource.data.keys().hasOnly(['topicId', 'ownerUid', 'active', 'audience', 'createdAt', 'revokedAt'])
        && (isAdmin() || isTopicOwner(request.resource.data.topicId));

      allow update: if isAdmin()
        ? request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.topicId == resource.data.topicId
          && request.resource.data.keys().hasOnly(['topicId', 'ownerUid', 'active', 'audience', 'createdAt', 'revokedAt'])
          && ((resource.data.active == true
              && request.resource.data.active == true
              && request.resource.data.audience in ['anyone', 'approvedUsers'])
            || (resource.data.active == true && request.resource.data.active == false))
        : isApproved()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.topicId == resource.data.topicId
          && request.resource.data.keys().hasOnly(['topicId', 'ownerUid', 'active', 'audience', 'createdAt', 'revokedAt'])
          && ((resource.data.active == true
              && request.resource.data.active == true
              && request.resource.data.audience in ['anyone', 'approvedUsers'])
            || (resource.data.active == true && request.resource.data.active == false));

      allow delete: if isAdmin();
    }
  }
}
