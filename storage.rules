rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').lower() == 'tuananhdao.dev.js@gmail.com';
    }

    function isApproved() {
      return isAdmin()
        || (request.auth != null
          && firestore.exists(/databases/(default)/documents/accessRequests/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/accessRequests/$(request.auth.uid)).data.status == 'approved');
    }

    function isTopicOwner(topicId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/topics/$(topicId))
        && firestore.get(/databases/(default)/documents/topics/$(topicId)).data.ownerId == request.auth.uid;
    }

    function hasEditorRole(topicId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/topics/$(topicId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/topics/$(topicId)/members/$(request.auth.uid)).data.role == 'editor';
    }

    function canViewTopic(topicId) {
      return isAdmin()
        || (isApproved()
          && (isTopicOwner(topicId)
            || (request.auth != null
              && firestore.exists(/databases/(default)/documents/topics/$(topicId)/members/$(request.auth.uid))
              && firestore.get(/databases/(default)/documents/topics/$(topicId)/members/$(request.auth.uid)).data.role in ['viewer', 'editor'])));
    }

    function shareAudienceAllows(share) {
      return share.get('audience', 'anyone') == 'anyone'
        || (share.get('audience', 'anyone') == 'approvedUsers'
          && request.auth != null
          && request.auth.token.get('email_verified', false) == true
          && isApproved());
    }

    function hasActiveShare(topicId, shareId) {
      return shareId is string
        && firestore.exists(/databases/(default)/documents/publicShares/$(shareId))
        && firestore.get(/databases/(default)/documents/publicShares/$(shareId)).data.get('topicId', '') == topicId
        && firestore.get(/databases/(default)/documents/publicShares/$(shareId)).data.get('active', false) == true
        && shareAudienceAllows(firestore.get(/databases/(default)/documents/publicShares/$(shareId)).data);
    }

    function hasActivePublicLink(topicId) {
      return firestore.exists(/databases/(default)/documents/topics/$(topicId))
        && hasActiveShare(topicId, firestore.get(/databases/(default)/documents/topics/$(topicId)).data.get('publicShareId', null));
    }

    function canEditTopic(topicId) {
      return isAdmin() || (isApproved() && (isTopicOwner(topicId) || hasEditorRole(topicId)));
    }

    function supportedFileType(contentType) {
      return contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/avif']
        || contentType == 'application/pdf'
        || contentType == 'application/msword'
        || contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || contentType == 'application/vnd.ms-excel'
        || contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || contentType == 'application/vnd.ms-powerpoint'
        || contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        || contentType == 'application/vnd.oasis.opendocument.text'
        || contentType == 'application/vnd.oasis.opendocument.spreadsheet'
        || contentType == 'application/vnd.oasis.opendocument.presentation';
    }

    match /topics/{topicId}/{filePath=**} {
      allow read: if canViewTopic(topicId) || hasActivePublicLink(topicId);
      allow create, update: if canEditTopic(topicId)
        && request.resource.size <= 25 * 1024 * 1024
        && supportedFileType(request.resource.contentType);
      allow delete: if canEditTopic(topicId);
    }
  }
}
